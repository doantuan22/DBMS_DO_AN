PORT=4000
NODE_ENV=development

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=CinemaBooking
# Application login: EXECUTE on stored procedures only (see database/security).
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

FRONTEND_URL=http://localhost:5173

# Generate a private key with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
