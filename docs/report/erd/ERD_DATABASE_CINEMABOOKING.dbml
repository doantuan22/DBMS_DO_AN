// Complete relational model from CinemaBookingDB dbo metadata, surveyed 2026-10-15.

Table dbo.VAITRO {
  VaiTroID int [pk, increment, not null]
  MaVaiTro varchar(50) [not null]
  TenVaiTro nvarchar(100) [not null]
  MoTa nvarchar(255)

  indexes {
    (MaVaiTro) [unique, name: `UQ_VAITRO_MaVaiTro`]
  }
}

Table dbo.QUYEN {
  QuyenID int [pk, increment, not null]
  MaQuyen varchar(50) [not null]
  TenQuyen nvarchar(100) [not null]
  MoTa nvarchar(255)

  indexes {
    (MaQuyen) [unique, name: `UQ_QUYEN_MaQuyen`]
  }
}

Table dbo.VAITRO_QUYEN {
  VaiTroID int [not null]
  QuyenID int [not null]
  NgayGan datetime2(7) [not null, default: `([dbo].[fn_BayGio]())`]

  indexes {
    (VaiTroID, QuyenID) [pk, name: `PK_VAITRO_QUYEN`]
  }
}

Table dbo.NGUOIDUNG {
  NguoiDungID int [pk, increment, not null]
  VaiTroID int [not null]
  HoTen nvarchar(100) [not null]
  Email varchar(150) [not null]
  MatKhau varchar(255) [not null]
  SoDienThoai varchar(20)
  NgayTao datetime2(7) [not null, default: `([dbo].[fn_BayGio]())`]
  TrangThai nvarchar(50) [not null, default: `(N'Hoạt động')`]

  indexes {
    (Email) [unique, name: `UQ_NGUOIDUNG_Email`]
    (TrangThai) [name: `IX_NGUOIDUNG_TrangThai`]
    (VaiTroID) [name: `IX_NGUOIDUNG_VaiTroID`]
    (SoDienThoai) [name: `UQ_NGUOIDUNG_SoDienThoai`, unique] // filtered: ([SoDienThoai] IS NOT NULL)
  }

  checks {
    `([TrangThai]=N'Chưa kích hoạt' OR [TrangThai]=N'Bị khóa' OR [TrangThai]=N'Hoạt động')` [name: `CK_NGUOIDUNG_TrangThai`]
  }
}

Table dbo.HOSOKHACHHANG {
  NguoiDungID int [pk, not null]
  NgaySinh date
  GioiTinh nvarchar(10)
  DiemTichLuy int [not null, default: `((0))`]

  checks {
    `([DiemTichLuy]>=(0))` [name: `CK_HOSOKHACHHANG_DiemTichLuy`]
    `([GioiTinh] IS NULL OR ([GioiTinh]=N'Khác' OR [GioiTinh]=N'Nữ' OR [GioiTinh]=N'Nam'))` [name: `CK_HOSOKHACHHANG_GioiTinh`]
  }
}

Table dbo.PHANCONG_RAP {
  PhanCongID int [pk, increment, not null]
  NguoiDungID int [not null]
  RapID int [not null]
  NgayBatDau date [not null]
  NgayKetThuc date
  TrangThai nvarchar(50) [not null, default: `(N'Hiệu lực')`]

  indexes {
    (NguoiDungID, TrangThai, NgayBatDau, NgayKetThuc) [name: `IX_PHANCONG_RAP_NguoiDung`]
    (RapID, TrangThai) [name: `IX_PHANCONG_RAP_Rap`]
  }

  checks {
    `([NgayKetThuc] IS NULL OR [NgayKetThuc]>=[NgayBatDau])` [name: `CK_PHANCONG_RAP_ThoiGian`]
    `([TrangThai]=N'Đã hủy' OR [TrangThai]=N'Hết hạn' OR [TrangThai]=N'Hiệu lực')` [name: `CK_PHANCONG_RAP_TrangThai`]
  }
}

Table dbo.RAPCHIEUPHIM {
  RapID int [pk, increment, not null]
  TenRap nvarchar(150) [not null]
  DiaChi nvarchar(255) [not null]
  ThanhPho nvarchar(100) [not null]
  SoDienThoai varchar(20)
  MoTa nvarchar(500)
  NgayHoatDong date
  TrangThai nvarchar(50) [not null, default: `(N'Hoạt động')`]

  checks {
    `([TrangThai]=N'Tạm đóng' OR [TrangThai]=N'Bảo trì' OR [TrangThai]=N'Hoạt động')` [name: `CK_RAPCHIEUPHIM_TrangThai`]
  }
}

Table dbo.HINHANH_RAPCHIEUPHIM {
  HinhAnhRapID int [pk, increment, not null]
  RapID int [not null]
  URL nvarchar(500) [not null]
  MoTa nvarchar(255)
  LaAnhDaiDien bit [not null, default: `((0))`]
  ThuTuHienThi int [not null, default: `((0))`]
  TrangThai nvarchar(50) [not null, default: `(N'Hoạt động')`]
  NgayTao datetime2(7) [not null, default: `([dbo].[fn_BayGio]())`]

  indexes {
    (RapID, TrangThai, ThuTuHienThi, HinhAnhRapID) [name: `IX_HINHANH_RAPCHIEUPHIM_Rap_TrangThai_ThuTu`]
    (RapID) [name: `UX_HINHANH_RAPCHIEUPHIM_Rap_Cover`, unique] // filtered: ([LaAnhDaiDien]=(1))
  }

  checks {
    `([ThuTuHienThi]>=(0))` [name: `CK_HINHANH_RAPCHIEUPHIM_ThuTuHienThi`]
    `([TrangThai]=N'Tạm ẩn' OR [TrangThai]=N'Hoạt động')` [name: `CK_HINHANH_RAPCHIEUPHIM_TrangThai`]
    `(len(ltrim(rtrim([URL])))>(0))` [name: `CK_HINHANH_RAPCHIEUPHIM_URL`]
  }
}

Table dbo.PHONGCHIEU {
  PhongID int [pk, increment, not null]
  RapID int [not null]
  TenPhong nvarchar(100) [not null]
  LoaiPhong nvarchar(50) [not null, default: `(N'2D')`]
  TrangThai nvarchar(50) [not null, default: `(N'Hoạt động')`]

  indexes {
    (RapID, TenPhong) [unique, name: `UQ_PHONGCHIEU_TenPhong`]
    (RapID, TrangThai) [name: `IX_PHONGCHIEU_RapID`]
  }

  checks {
    `([LoaiPhong]=N'ScreenX' OR [LoaiPhong]=N'4DX' OR [LoaiPhong]=N'IMAX' OR [LoaiPhong]=N'3D' OR [LoaiPhong]=N'2D')` [name: `CK_PHONGCHIEU_LoaiPhong`]
    `([TrangThai]=N'Ngưng hoạt động' OR [TrangThai]=N'Bảo trì' OR [TrangThai]=N'Hoạt động')` [name: `CK_PHONGCHIEU_TrangThai`]
  }
}

Table dbo.GHE {
  GheID int [pk, increment, not null]
  PhongID int [not null]
  HangGhe varchar(10) [not null]
  SoGhe int [not null]
  LoaiGhe nvarchar(50) [not null, default: `(N'Thường')`]
  TrangThai nvarchar(50) [not null, default: `(N'Hoạt động')`]

  indexes {
    (PhongID, HangGhe, SoGhe) [unique, name: `UQ_GHE_ViTri`]
    (PhongID, LoaiGhe, TrangThai) [name: `IX_GHE_PhongID_LoaiGhe`]
  }

  checks {
    `([LoaiGhe]=N'Đôi' OR [LoaiGhe]=N'Sweetbox' OR [LoaiGhe]=N'VIP' OR [LoaiGhe]=N'Thường')` [name: `CK_GHE_LoaiGhe`]
    `([SoGhe]>(0))` [name: `CK_GHE_SoGhe`]
    `([TrangThai]=N'Bảo trì' OR [TrangThai]=N'Hỏng' OR [TrangThai]=N'Hoạt động')` [name: `CK_GHE_TrangThai`]
  }
}

Table dbo.PHIM {
  PhimID int [pk, increment, not null]
  TenPhim nvarchar(255) [not null]
  ThoiLuong int [not null]
  NgayKhoiChieu date [not null]
  NgayKetThuc date
  NgonNgu nvarchar(100)
  PhuDe nvarchar(100)
  DoTuoi nvarchar(20)
  DaoDien nvarchar(150)
  MoTa nvarchar(max)
  PosterURL nvarchar(500)
  TrailerURL nvarchar(500)
  TrangThai nvarchar(50) [not null, default: `(N'Sắp chiếu')`]

  indexes {
    (TrangThai, NgayKhoiChieu) [name: `IX_PHIM_TrangThai`]
  }

  checks {
    `([DoTuoi] IS NULL OR ([DoTuoi]=N'C' OR [DoTuoi]=N'T18' OR [DoTuoi]=N'T16' OR [DoTuoi]=N'T13' OR [DoTuoi]=N'K' OR [DoTuoi]=N'P'))` [name: `CK_PHIM_DoTuoi`]
    `([NgayKetThuc] IS NULL OR [NgayKetThuc]>=[NgayKhoiChieu])` [name: `CK_PHIM_ThoiGian`]
    `([ThoiLuong]>(0))` [name: `CK_PHIM_ThoiLuong`]
    `([TrangThai]=N'Ngừng chiếu' OR [TrangThai]=N'Đang chiếu' OR [TrangThai]=N'Sắp chiếu')` [name: `CK_PHIM_TrangThai`]
  }
}

Table dbo.THELOAI {
  TheLoaiID int [pk, increment, not null]
  TenTheLoai nvarchar(100) [not null]

  indexes {
    (TenTheLoai) [unique, name: `UQ_THELOAI_TenTheLoai`]
  }
}

Table dbo.DIENVIEN {
  DienVienID int [pk, increment, not null]
  HoTen nvarchar(150) [not null]
  NgaySinh date
  QuocTich nvarchar(100)
}

Table dbo.PHIM_THELOAI {
  PhimID int [not null]
  TheLoaiID int [not null]

  indexes {
    (PhimID, TheLoaiID) [pk, name: `PK_PHIM_THELOAI`]
  }
}

Table dbo.PHIM_DIENVIEN {
  PhimID int [not null]
  DienVienID int [not null]
  VaiDien nvarchar(150)

  indexes {
    (PhimID, DienVienID) [pk, name: `PK_PHIM_DIENVIEN`]
  }
}

Table dbo.SUATCHIEU {
  SuatChieuID int [pk, increment, not null]
  PhimID int [not null]
  PhongID int [not null]
  ThoiGianBatDau datetime2(7) [not null]
  ThoiGianKetThuc datetime2(7) [not null]
  DinhDang nvarchar(50) [not null, default: `(N'2D')`]
  GiaVeCoBan decimal(18,2) [not null]
  TrangThai nvarchar(50) [not null, default: `(N'Mở bán')`]

  indexes {
    (PhimID, ThoiGianBatDau, TrangThai) [name: `IX_SUATCHIEU_Phim_ThoiGian`]
    (PhongID, ThoiGianBatDau, ThoiGianKetThuc) [name: `IX_SUATCHIEU_Phong_ThoiGian`]
  }

  checks {
    `([DinhDang]=N'ScreenX' OR [DinhDang]=N'4DX' OR [DinhDang]=N'IMAX' OR [DinhDang]=N'3D' OR [DinhDang]=N'2D')` [name: `CK_SUATCHIEU_DinhDang`]
    `([GiaVeCoBan]>=(0))` [name: `CK_SUATCHIEU_GiaVeCoBan`]
    `([ThoiGianKetThuc]>[ThoiGianBatDau])` [name: `CK_SUATCHIEU_ThoiGian`]
    `([TrangThai]=N'Hoàn thành' OR [TrangThai]=N'Đã hủy' OR [TrangThai]=N'Đóng bán' OR [TrangThai]=N'Mở bán')` [name: `CK_SUATCHIEU_TrangThai`]
  }
}

Table dbo.BANGGIA {
  GiaID int [pk, increment, not null]
  RapID int [not null]
  LoaiGhe nvarchar(50) [not null]
  LoaiNgay nvarchar(50) [not null]
  DinhDang nvarchar(50) [not null]
  PhuThu decimal(18,2) [not null, default: `((0))`]
  NgayBatDau date [not null]
  NgayKetThuc date
  TrangThai nvarchar(50) [not null, default: `(N'Áp dụng')`]

  indexes {
    (RapID, LoaiGhe, LoaiNgay, DinhDang, TrangThai, NgayBatDau, NgayKetThuc) [name: `IX_BANGGIA_Lookup`]
  }

  checks {
    `([DinhDang]=N'Tất cả' OR [DinhDang]=N'ScreenX' OR [DinhDang]=N'4DX' OR [DinhDang]=N'IMAX' OR [DinhDang]=N'3D' OR [DinhDang]=N'2D')` [name: `CK_BANGGIA_DinhDang`]
    `([LoaiGhe]=N'Tất cả' OR [LoaiGhe]=N'Đôi' OR [LoaiGhe]=N'Sweetbox' OR [LoaiGhe]=N'VIP' OR [LoaiGhe]=N'Thường')` [name: `CK_BANGGIA_LoaiGhe`]
    `([LoaiNgay]=N'Tất cả' OR [LoaiNgay]=N'Cuối tuần' OR [LoaiNgay]=N'Ngày thường')` [name: `CK_BANGGIA_LoaiNgay`]
    `([PhuThu]>=(0))` [name: `CK_BANGGIA_PhuThu`]
    `([NgayKetThuc] IS NULL OR [NgayKetThuc]>=[NgayBatDau])` [name: `CK_BANGGIA_ThoiGian`]
    `([TrangThai]=N'Tạm dừng' OR [TrangThai]=N'Hết hạn' OR [TrangThai]=N'Áp dụng')` [name: `CK_BANGGIA_TrangThai`]
  }
}

Table dbo.DONDATVE {
  DonDatVeID int [pk, increment, not null]
  NguoiDungID int [not null]
  SuatChieuID int [not null]
  KhuyenMaiID int
  NgayDat datetime2(7) [not null, default: `([dbo].[fn_BayGio]())`]
  TongTienVe decimal(18,2) [not null, default: `((0))`]
  TongTienDoAn decimal(18,2) [not null, default: `((0))`]
  TienGiamGia decimal(18,2) [not null, default: `((0))`]
  TrangThai nvarchar(50) [not null, default: `(N'Chờ thanh toán')`]
  HanGiuCho datetime2(7)
  LyDoHuy nvarchar(255)
  ThongBaoHuy nvarchar(255)
  DiemSuDung int [not null, default: `((0))`]

  indexes {
    (HanGiuCho) [name: `IX_DONDATVE_HanGiuCho`] // filtered: ([TrangThai]=N'Chờ thanh toán')
    (KhuyenMaiID) [name: `IX_DONDATVE_KhuyenMai`] // filtered: ([KhuyenMaiID] IS NOT NULL)
    (NguoiDungID, NgayDat) [name: `IX_DONDATVE_NguoiDung`]
    (SuatChieuID, TrangThai) [name: `IX_DONDATVE_SuatChieu`]
  }

  checks {
    `([DiemSuDung]>=(0))` [name: `CK_DONDATVE_DiemSuDung`]
    `([TrangThai]<>N'Chờ thanh toán' OR [HanGiuCho] IS NOT NULL)` [name: `CK_DONDATVE_HanGiuCho`]
    `([TienGiamGia]>=(0))` [name: `CK_DONDATVE_TienGiamGia`]
    `([TienGiamGia]<=([TongTienVe]+[TongTienDoAn]))` [name: `CK_DONDATVE_TongGiam`]
    `([TongTienDoAn]>=(0))` [name: `CK_DONDATVE_TongTienDoAn`]
    `([TongTienVe]>=(0))` [name: `CK_DONDATVE_TongTienVe`]
    `([TrangThai]=N'Hoàn thành' OR [TrangThai]=N'Hết hạn' OR [TrangThai]=N'Hoàn tiền' OR [TrangThai]=N'Đã hủy' OR [TrangThai]=N'Đã thanh toán' OR [TrangThai]=N'Chờ thanh toán')` [name: `CK_DONDATVE_TrangThai`]
  }
}

Table dbo.CHITIETVE {
  VeID int [pk, increment, not null]
  DonDatVeID int [not null]
  GheID int [not null]
  GiaVe decimal(18,2) [not null]
  MaVe varchar(100) [not null]
  TrangThai nvarchar(50) [not null, default: `(N'Đã đặt')`]

  indexes {
    (MaVe) [unique, name: `UQ_CHITIETVE_MaVe`]
    (DonDatVeID) [name: `IX_CHITIETVE_DonDatVe`]
    (GheID, TrangThai) [name: `IX_CHITIETVE_GheID`]
  }

  checks {
    `([GiaVe]>=(0))` [name: `CK_CHITIETVE_GiaVe`]
    `([TrangThai]=N'Đã hủy' OR [TrangThai]=N'Đã sử dụng' OR [TrangThai]=N'Đã đặt')` [name: `CK_CHITIETVE_TrangThai`]
  }
}

Table dbo.SANPHAM {
  SanPhamID int [pk, increment, not null]
  TenSanPham nvarchar(150) [not null]
  LoaiSanPham nvarchar(50) [not null]
  Gia decimal(18,2) [not null]
  MoTa nvarchar(255)
  HinhAnh nvarchar(500)
  TrangThai nvarchar(50) [not null, default: `(N'Đang bán')`]

  checks {
    `([Gia]>=(0))` [name: `CK_SANPHAM_Gia`]
    `([LoaiSanPham]=N'Khác' OR [LoaiSanPham]=N'Snack' OR [LoaiSanPham]=N'Combo' OR [LoaiSanPham]=N'Nước ngọt' OR [LoaiSanPham]=N'Bắp rang')` [name: `CK_SANPHAM_LoaiSanPham`]
    `([TrangThai]=N'Ngừng bán' OR [TrangThai]=N'Hết hàng' OR [TrangThai]=N'Đang bán')` [name: `CK_SANPHAM_TrangThai`]
  }
}

Table dbo.CHITIETDOAN {
  ChiTietDoAnID int [pk, increment, not null]
  DonDatVeID int [not null]
  SanPhamID int [not null]
  SoLuong int [not null]
  DonGia decimal(18,2) [not null]

  indexes {
    (DonDatVeID, SanPhamID) [unique, name: `UQ_CHITIETDOAN_Don_SanPham`]
  }

  checks {
    `([DonGia]>=(0))` [name: `CK_CHITIETDOAN_DonGia`]
    `([SoLuong]>(0))` [name: `CK_CHITIETDOAN_SoLuong`]
  }
}

Table dbo.KHUYENMAI {
  KhuyenMaiID int [pk, increment, not null]
  MaCode varchar(50) [not null]
  MoTa nvarchar(255)
  LoaiGiamGia nvarchar(20) [not null]
  GiaTriGiam decimal(18,2) [not null]
  DonHangToiThieu decimal(18,2) [not null, default: `((0))`]
  GiamToiDa decimal(18,2)
  NgayBatDau datetime2(7) [not null]
  NgayKetThuc datetime2(7) [not null]
  SoLuong int [not null]
  SoLuongDaDung int [not null, default: `((0))`]
  TrangThai nvarchar(50) [not null, default: `(N'Hoạt động')`]

  indexes {
    (MaCode) [unique, name: `UQ_KHUYENMAI_MaCode`]
  }

  checks {
    `([DonHangToiThieu]>=(0))` [name: `CK_KHUYENMAI_DonHangToiThieu`]
    `([GiamToiDa] IS NULL OR [GiamToiDa]>=(0))` [name: `CK_KHUYENMAI_GiamToiDa`]
    `([GiaTriGiam]>(0))` [name: `CK_KHUYENMAI_GiaTriGiam`]
    `([LoaiGiamGia]=N'FIXED' OR [LoaiGiamGia]=N'PERCENT' OR [LoaiGiamGia]=N'Số tiền' OR [LoaiGiamGia]=N'Phần trăm')` [name: `CK_KHUYENMAI_LoaiGiamGia`]
    `(NOT ([LoaiGiamGia]=N'PERCENT' OR [LoaiGiamGia]=N'Phần trăm') OR [GiaTriGiam]<=(99))` [name: `CK_KHUYENMAI_PhanTram99`]
    `([SoLuong]>=(0) AND [SoLuongDaDung]>=(0) AND [SoLuongDaDung]<=[SoLuong])` [name: `CK_KHUYENMAI_SoLuong`]
    `([NgayKetThuc]>=[NgayBatDau])` [name: `CK_KHUYENMAI_ThoiGian`]
    `([TrangThai]=N'Tạm dừng' OR [TrangThai]=N'Hết hạn' OR [TrangThai]=N'Hoạt động')` [name: `CK_KHUYENMAI_TrangThai`]
  }
}

Table dbo.THANHTOAN {
  ThanhToanID int [pk, increment, not null]
  DonDatVeID int [not null]
  PhuongThuc nvarchar(50) [not null]
  NgayTao datetime2(7) [not null, default: `([dbo].[fn_BayGio]())`]
  NgayThanhToan datetime2(7)
  MaGiaoDich varchar(100)
  TrangThai nvarchar(50) [not null, default: `(N'Đang xử lý')`]
  GhiChu nvarchar(255)

  indexes {
    (DonDatVeID, TrangThai) [name: `IX_THANHTOAN_DonDatVe`]
    (MaGiaoDich) [name: `UQ_THANHTOAN_MaGiaoDich`, unique] // filtered: ([MaGiaoDich] IS NOT NULL)
  }

  checks {
    `([PhuongThuc]=N'TIEN_MAT' OR [PhuongThuc]=N'THE_QUOC_TE' OR [PhuongThuc]=N'THE_NOI_DIA' OR [PhuongThuc]=N'ZALOPAY' OR [PhuongThuc]=N'MOMO' OR [PhuongThuc]=N'VNPAY' OR [PhuongThuc]=N'DIEM')` [name: `CK_THANHTOAN_PhuongThuc`]
    `([TrangThai]=N'Đã hoàn tiền' OR [TrangThai]=N'Thất bại' OR [TrangThai]=N'Thành công' OR [TrangThai]=N'Đang xử lý')` [name: `CK_THANHTOAN_TrangThai`]
  }
}

