  DiemBoiThuong int [not null]
  NgayBoiThuong datetime2(7) [not null]
  GhiChu nvarchar(255)

  indexes {
    (DonDatVeID) [unique, name: `UQ_BOITHUONG_HUYSUAT_Don`]
  }

  checks {
    `([DiemBoiThuong]>=(0))` [name: `CK_BOITHUONG_HUYSUAT_Diem`]
  }
}

Table dbo.DANHGIAPHIM {
  DanhGiaID int [pk, increment, not null]
  PhimID int [not null]
  NguoiDungID int [not null]
  SoSao int [not null]
  NoiDung nvarchar(1000)
  NgayDanhGia datetime2(7) [not null, default: `([dbo].[fn_BayGio]())`]

  indexes {
    (PhimID, NguoiDungID) [unique, name: `UQ_DANHGIAPHIM_Phim_User`]
  }

  checks {
    `([SoSao]>=(1) AND [SoSao]<=(5))` [name: `CK_DANHGIAPHIM_SoSao`]
  }
}

Table dbo.KHIEUNAI {
  KhieuNaiID int [pk, increment, not null]
  NguoiDungID int [not null]
  DonDatVeID int
  LoaiKhieuNai nvarchar(100) [not null]
  TieuDe nvarchar(200) [not null]
  NoiDung nvarchar(max) [not null]
  MucDoUuTien nvarchar(50) [not null, default: `(N'Trung bình')`]
  NgayTao datetime2(7) [not null, default: `([dbo].[fn_BayGio]())`]
  TrangThai nvarchar(50) [not null, default: `(N'Mới')`]
  NhanVienPhuTrachID int

  indexes {
    (DonDatVeID) [name: `IX_KHIEUNAI_DonDatVe`] // filtered: ([DonDatVeID] IS NOT NULL)
    (NguoiDungID, TrangThai) [name: `IX_KHIEUNAI_NguoiDung`]
    (NhanVienPhuTrachID, TrangThai) [name: `IX_KHIEUNAI_NhanVienPhuTrach`]
    (TrangThai, MucDoUuTien, NgayTao) [name: `IX_KHIEUNAI_TrangThai`]
  }

  checks {
    `([MucDoUuTien]=N'Khẩn cấp' OR [MucDoUuTien]=N'Cao' OR [MucDoUuTien]=N'Trung bình' OR [MucDoUuTien]=N'Thấp')` [name: `CK_KHIEUNAI_MucDoUuTien`]
    `([TrangThai]=N'Từ chối' OR [TrangThai]=N'Đã đóng' OR [TrangThai]=N'Đã giải quyết' OR [TrangThai]=N'Đang xử lý' OR [TrangThai]=N'Mới')` [name: `CK_KHIEUNAI_TrangThai`]
  }
}

Table dbo.TINNHAN_KHIEUNAI {
  TinNhanID int [pk, increment, not null]
  KhieuNaiID int [not null]
  NguoiGuiID int [not null]
  NoiDung nvarchar(max) [not null]
  LoaiTinNhan nvarchar(50) [not null, default: `(N'Công khai')`]
  ThoiGianGui datetime2(7) [not null, default: `([dbo].[fn_BayGio]())`]

  indexes {
    (KhieuNaiID, ThoiGianGui, TinNhanID) [name: `IX_TINNHAN_KHIEUNAI_KhieuNai_ThoiGian`]
  }

  checks {
    `([LoaiTinNhan]=N'Công khai' OR [LoaiTinNhan]=N'Nội bộ')` [name: `CK_TINNHAN_KHIEUNAI_LoaiTinNhan`]
    `(len(ltrim(rtrim([NoiDung])))>(0))` [name: `CK_TINNHAN_KHIEUNAI_NoiDung`]
  }
}

Table dbo.XULY_KHIEUNAI {
  XuLyID int [pk, increment, not null]
  KhieuNaiID int [not null]
  NguoiXuLyID int [not null]
  NoiDungXuLy nvarchar(max) [not null]
  NgayXuLy datetime2(7) [not null, default: `([dbo].[fn_BayGio]())`]
  TrangThaiSauXuLy nvarchar(50) [not null]

  indexes {
    (KhieuNaiID, NgayXuLy) [name: `IX_XULY_KHIEUNAI_KhieuNai`]
  }

  checks {
    `([TrangThaiSauXuLy]=N'Từ chối' OR [TrangThaiSauXuLy]=N'Đã đóng' OR [TrangThaiSauXuLy]=N'Đã giải quyết' OR [TrangThaiSauXuLy]=N'Đang xử lý')` [name: `CK_XULY_KHIEUNAI_TrangThaiSauXuLy`]
  }
}

Table dbo.YEUCAU_CHUYENCAP {
  YeuCauID int [pk, increment, not null]
  KhieuNaiID int [not null]
  NguoiYeuCauID int [not null]
  LyDo nvarchar(500) [not null]
  MucDoUuTien nvarchar(50) [not null, default: `(N'Trung bình')`]
  AdminPhuTrachID int
  TrangThai nvarchar(50) [not null, default: `(N'Chờ tiếp nhận')`]
  ThoiGianGui datetime2(7) [not null, default: `([dbo].[fn_BayGio]())`]
  ThoiGianTiepNhan datetime2(7)
  KetQuaXuLy nvarchar(max)
  ThoiGianHoanTat datetime2(7)

  indexes {
    (KhieuNaiID, ThoiGianGui) [name: `IX_YEUCAU_CHUYENCAP_KhieuNai`]
    (TrangThai, MucDoUuTien, ThoiGianGui) [name: `IX_YEUCAU_CHUYENCAP_TrangThai_UuTien`]
    (KhieuNaiID) [name: `UQ_YEUCAU_CHUYENCAP_ChoTiepNhan`, unique] // filtered: ([TrangThai]=N'Chờ tiếp nhận')
    (KhieuNaiID) [name: `UQ_YEUCAU_CHUYENCAP_DangXuLy`, unique] // filtered: ([TrangThai]=N'Đang xử lý')
  }

  checks {
    `(NOT ([TrangThai]=N'Từ chối' OR [TrangThai]=N'Đã giải quyết') OR [KetQuaXuLy] IS NOT NULL AND len(ltrim(rtrim([KetQuaXuLy])))>(0) AND [ThoiGianHoanTat] IS NOT NULL)` [name: `CK_YEUCAU_CHUYENCAP_KetQua`]
    `(len(ltrim(rtrim([LyDo])))>(0))` [name: `CK_YEUCAU_CHUYENCAP_LyDo`]
    `([MucDoUuTien]=N'Khẩn cấp' OR [MucDoUuTien]=N'Cao' OR [MucDoUuTien]=N'Trung bình' OR [MucDoUuTien]=N'Thấp')` [name: `CK_YEUCAU_CHUYENCAP_MucDoUuTien`]
    `([ThoiGianHoanTat] IS NULL OR [ThoiGianTiepNhan] IS NOT NULL AND [ThoiGianHoanTat]>=[ThoiGianTiepNhan])` [name: `CK_YEUCAU_CHUYENCAP_ThoiGianHoanTat`]
    `([ThoiGianTiepNhan] IS NULL OR [ThoiGianTiepNhan]>=[ThoiGianGui])` [name: `CK_YEUCAU_CHUYENCAP_ThoiGianTiepNhan`]
    `([TrangThai]=N'Chờ tiếp nhận' OR [TrangThai]=N'Đang xử lý' OR [TrangThai]=N'Đã giải quyết' OR [TrangThai]=N'Từ chối')` [name: `CK_YEUCAU_CHUYENCAP_TrangThai`]
  }
}

