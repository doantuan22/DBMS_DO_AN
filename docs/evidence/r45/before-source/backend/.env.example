PORT=4000
NODE_ENV=development

DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=CinemaBookingDB
# DEV / R0 rebuild only. Production uses an EXECUTE-only application login.
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

FRONTEND_URL=http://localhost:5173

# Generate a private key with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Release: set NODE_ENV=production and use a separately provisioned db_executor login.
# Do not use the development sa account or commit credentials in a deployed environment.
# FRONTEND_URL is the permitted browser origin; keep JWT_SECRET private.
