{
  "name": "cinema-booking",
  "private": true,
  "description": "Convenience scripts only. frontend/ and backend/ are independent packages (no workspaces).",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "format": "prettier --write \"backend/src/**/*.js\" \"backend/tests/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"frontend/tests/**/*.js\" \"frontend/*.js\" \"frontend/index.html\" \"scripts/**/*.mjs\" \"shared/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"backend/src/**/*.js\" \"backend/tests/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"frontend/tests/**/*.js\" \"frontend/*.js\" \"frontend/index.html\" \"scripts/**/*.mjs\" \"shared/**/*.{js,mjs}\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "audit:no-sql": "node scripts/audit-no-sql.mjs",
    "db:inventory": "node scripts/db/inventory.mjs",
    "db:reset": "node scripts/db/run.mjs reset",
    "db:build": "node scripts/db/run.mjs build",
    "db:seed": "node scripts/db/run.mjs seed",
    "db:verify": "node scripts/db/run.mjs verify",
    "db:test": "node scripts/db/run.mjs test",
    "db:smoke": "node scripts/db/backend-smoke.mjs",
    "db:refresh-manifest": "node scripts/db/refresh-manifest.mjs",
    "db:contracts": "node scripts/db/contract-check.mjs",
    "db:test:preflight": "node scripts/db/run.mjs preflight-test",
    "db:test:build": "node scripts/db/run.mjs build-test",
    "db:test:fixture": "node scripts/db/run.mjs fixture-test",
    "db:test:rebuild": "node scripts/db/run.mjs rebuild-test"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
