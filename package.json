{
  "name": "cinema-booking",
  "private": true,
  "description": "Convenience scripts only. frontend/ and backend/ are independent packages (no workspaces).",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "format": "prettier --write \"backend/src/**/*.js\" \"backend/tests/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"frontend/tests/**/*.js\" \"frontend/*.js\" \"frontend/index.html\" \"shared/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"backend/src/**/*.js\" \"backend/tests/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"frontend/tests/**/*.js\" \"frontend/*.js\" \"frontend/index.html\" \"shared/**/*.{js,mjs}\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.9"
  }
}
