{
  "name": "cinema-booking",
  "private": true,
  "description": "Convenience scripts only. frontend/ and backend/ are independent packages (no workspaces).",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "format": "prettier --write \"backend/src/**/*.js\" \"backend/tests/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"frontend/tests/**/*.js\" \"frontend/*.js\" \"frontend/index.html\" \"shared/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"backend/src/**/*.js\" \"backend/tests/**/*.js\" \"frontend/src/**/*.{js,jsx,css}\" \"frontend/tests/**/*.js\" \"frontend/*.js\" \"frontend/index.html\" \"shared/**/*.{js,mjs}\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "audit:db": "node scripts/audit/db-integrity.mjs",
    "audit:api": "node scripts/audit/api-integration.mjs",
    "audit:e2e": "node scripts/audit/browser-e2e.mjs",
    "audit:all": "node scripts/audit/run-all.mjs",
    "audit:lifecycle": "node scripts/audit/lifecycle.mjs",
    "audit:testdb": "node scripts/audit/test-db.mjs",
    "audit:points": "node scripts/audit/points-revenue.mjs",
    "audit:migrate": "node scripts/audit/apply-migration.mjs",
    "seed:demo": "node database/10_seed/generate-media.mjs && node database/10_seed/seed-demo.mjs",
    "seed:verify": "node database/10_seed/verify-seed.mjs",
    "seed:api": "node database/10_seed/verify-demo-api.mjs",
    "seed:all": "npm run seed:demo && npm run seed:verify && npm run seed:api"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "axe-core": "^4.10.2",
    "prettier": "^3.9.9"
  }
}
